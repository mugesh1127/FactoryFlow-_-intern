
{
  "name": "factoryflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"nodemon server/index.js\"",
    "build": "npm run build --workspace=client",
    "start": "node server/index.js",
    "db:init": "node server/init-db.js",
    "db:seed": "node server/seed-db.js",
    "db:test": "node server/test-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
